<style>
  .btn {
    background-color: #fe424d;
    color: white;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
  }

  .btn:hover {
    background-color: #fe424d;
    color: white;
  }

  .btn i {
    margin-right: 0.5rem;
  }
  .search-inp{
    border-radius: 25px;
    padding:0.5rem 3rem 0.5rem 3rem;
    font-size:1rem;
  }
</style>

<nav class="navbar bg-light border-bottom sticky-top">
  <div class="container-fluid d-flex align-items-center">

    <!-- Left side -->
    <a class="navbar-brand" href="/listings">
      <i class="fa-regular fa-compass"></i>
    </a>

    <ul class="navbar-nav flex-row align-items-center gap-3">
      <li class="nav-item">
        <a class="nav-link" href="/listings">Explore</a>
      </li>
    </ul>

    <div class="navbar-nav ms-auto">
      <form class="d-flex" role="search">
        <input class="form-control me-2 search-inp" type="search" placeholder="Search destinations"/>
        <button class="btn theme-success" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
      </form>
    </div>

    <!-- Right side -->
    <ul class="navbar-nav flex-row align-items-center gap-3 ms-auto">
      <li class="nav-item">
        <a class="nav-link" href="/listings/new">Airbnb your home</a>
      </li>
      <% if(!currUser){ %>
        <li class="nav-item">
          <a class="nav-link" href="/signup"><b>Sign up</b></a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/login"><b>Log in</b></a>
        </li>
        <% } %>
          <% if(currUser){ %>
            <li class="nav-item">
              <a class="nav-link" href="/logout"><b>Log out</b></a>
            </li>
            <% } %>
    </ul>

  </div>
</nav>